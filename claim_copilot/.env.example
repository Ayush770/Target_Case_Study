# AWS credentials — required for S3 upload and Textract OCR
# Copy this file to .env and fill in your values, then:
#   source .env && uvicorn api:app --reload
#
# Alternatively export these in your shell before starting the server.
#
# If ~/.aws/config uses a custom login_session provider (e.g. aws login),
# re-authenticate first:  aws login  (or aws sso login --profile <profile>)
# then restart uvicorn so boto3 picks up fresh credentials.

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1

# S3 bucket for claim document storage
# Default: candidate-pack-claims-dev-133715233089
S3_BUCKET=candidate-pack-claims-dev-133715233089
